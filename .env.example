# ── Anthropic (server-side only — never prefix with VITE_) ──
ANTHROPIC_API_KEY=sk-ant-...

# ── Proxy hardening (server-side, optional) ──
# Comma-separated origins allowed to call /api/* (your prod URL). Localhost dev
# ports are always allowed. Leave unset to allow only localhost + no-origin.
ALLOWED_ORIGINS=https://your-app.vercel.app
# Max /api requests per IP per minute (best-effort, per serverless instance).
RATE_LIMIT_PER_MIN=20

# ── Supabase (public anon key — safe to expose, prefixed with VITE_) ──
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Copy this file to .env for local dev
# Add these same vars in Vercel Dashboard → Project → Settings → Environment Variables
